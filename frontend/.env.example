# Rollaway frontend environment — copy to .env.local and fill in.
# .env.local is git-ignored; NEVER commit real values.

# Optional Mapbox public token (pk.*). Mapbox is enabled whenever this exists,
# including fixture mode. Restrict the token to your local/deployed site URLs.
# The schematic map remains available when this is blank or Mapbox is unavailable.
VITE_MAPBOX_TOKEN=

# true = use bundled deterministic Rollaway data and make no business-API calls.
# Mapbox styles, tiles, fonts, sprites, and telemetry may still use the network
# when VITE_MAPBOX_TOKEN is configured.
VITE_USE_FIXTURES=true

# Artificial fixture latency in milliseconds. Demonstrates the truck loader.
VITE_FIXTURE_DELAY_MS=1100

# Browser Google Maps Platform key (issues #17/#14). Ships in the bundle, so it
# MUST have an HTTP-referrer restriction locked to your local + deployed origins.
# Restrict to: Street View Static API + Places API (New) only. Never put the
# server-side Routes/Geocoding key here.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Live endpoints used only when VITE_USE_FIXTURES=false.
VITE_RECOMMEND_SPOTS_URL=
VITE_VENDORS_URL=
VITE_CLOSURES_URL=
VITE_PERMIT_CHECKLIST_URL=
# Gradient-backed menu extraction (agents runtime POST /menu_extract). Empty = local text-only fallback.
VITE_MENU_EXTRACT_URL=

# Compatibility note: the recommendation boundary also adapts the legacy
# POST /chat map_actions response when returned by VITE_RECOMMEND_SPOTS_URL.
# VITE_CHAT_ENDPOINT is no longer read by the map-first app.
