# Rollaway frontend environment — copy to .env.local and fill in.
# .env.local is git-ignored; NEVER commit real values.

# Mapbox public token (pk.*) — account.mapbox.com -> Tokens
VITE_MAPBOX_TOKEN=

# Gradient routed chat endpoint (from Person 2). Leave blank while in fixture mode.
VITE_CHAT_ENDPOINT=

# Live vendor GeoJSON from Person 3's get_vendors?format=geojson. Blank = bundled fixture.
VITE_VENDORS_URL=

# true = answer from local fixtures (no backend needed). false = call VITE_CHAT_ENDPOINT.
VITE_USE_FIXTURES=true
