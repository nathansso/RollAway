# Rollaway frontend — Railway static container (docs/MIGRATION-PLAN.md §1.2).
# Serves the Vite build from /srv with SPA routing. Everything except the
# content-hashed /assets bundle revalidates on every load (service-worker +
# runtime-config safety: index.html, config.json, sw.js, manifest all reach
# the SPA catch-all or root, so a path-list matcher would miss rewrites).

{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Vite emits content-hashed filenames under /assets — cache forever.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# App shell, config.json, service worker, manifest, SPA routes: always
	# revalidate so new deploys and runtime-config changes surface promptly.
	@mutable not path /assets/*
	header @mutable Cache-Control "no-cache, must-revalidate"

	# SPA catch-all: unknown paths serve the app shell.
	try_files {path} /index.html
	file_server
}
