# Copy to functions/.env and fill in. KEY NAMES ONLY here — never commit a
# real secret. Every function reads secrets exclusively from process.env.
# All four vars must exist in functions/.env for `doctl serverless deploy`
# (empty values are fine; functions degrade to documented fixtures).

# data.sfgov.org app token (optional but recommended — lifts anonymous rate
# limits). Free: data.sfgov.org -> profile -> app tokens.
SOCRATA_APP_TOKEN=

# Google Cloud key with "Places API (New)" enabled. Set a quota cap in the
# console so a bug can't bill you. Used by get_restaurants + check_clearance.
GOOGLE_PLACES_KEY=

# Server-side Google key for recommend_spots (issue #17): Distance Matrix API
# (traffic-aware travel) + Geocoding API (spot addresses). Keep this key
# server-only (no HTTP-referrer restriction). If unset, recommend_spots skips
# the traffic filter and addresses degrade to null.
GOOGLE_MAPS_SERVER_KEY=

# Ticketmaster Discovery API key (developer.ticketmaster.com). Used by get_events.
TICKETMASTER_KEY=

# Optional: URL of a JSON mirror of the SFMTA weekly event-closure list
# (shape documented in packages/rollaway/get_closures/data/sfmta_events.json).
# Leave empty to use the bundled sample.
SFMTA_EVENTS_URL=

# --- Demo-reliability + recommend_spots orchestrator (all optional; empty is
# fine — each has a documented fallback) ---

# DEMO_DATA_MODE: "1"/"true"/"on" => every Function reads a frozen snapshot from
# demo_data/ instead of hitting live APIs (deterministic, offline stage demo).
# Freeze first with `node functions/scripts/freeze_snapshots.mjs`. Leave empty
# for live mode (a transient live miss still fail-fast-degrades to snapshot).
DEMO_DATA_MODE=

# Mapbox access token (Directions/Matrix API) for recommend_spots travel times.
# PRIMARY path — live routing. Get one at account.mapbox.com. If unset,
# recommend_spots falls back to a haversine estimate (marked estimated:true).
MAPBOX_TOKEN=

# Base URL of the deployed rollaway functions namespace, e.g.
# https://faas-sfo3-....doserverless.co/api/v1/web/fn-.../rollaway
# When set, recommend_spots fans out to the sibling Functions over HTTP.
# Unset => local in-process require path (invoke_local / single-bundle dev).
FUNCTIONS_BASE_URL=

# Spot Scout endpoint (agents layer) that takes pre-gathered signals for all 3
# spots and returns [{ id, why_one_line }] in ONE call. Unset => deterministic
# templated why-lines. See GitHub issue #C.
SPOT_SCOUT_URL=

# Menu RAG endpoint (planned): POST { menu, nearby:{vendors,restaurants} } ->
# { overlap_score, overlapping[] }. Unset => deterministic cuisine+price bridge.
# Interface pinned in GitHub issue #B.
MENU_RAG_URL=

# Supabase (Phase 2 migration): get_foot_traffic reads station_hourly via
# PostgREST with the ANON key (read-only public tables). Empty => the bundled
# station_hourly.json snapshot is used instead.
SUPABASE_URL=
SUPABASE_ANON_KEY=
