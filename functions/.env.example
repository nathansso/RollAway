# Copy to functions/.env and fill in. KEY NAMES ONLY here — never commit a
# real secret. Every function reads secrets exclusively from process.env.
# All four vars must exist in functions/.env for `doctl serverless deploy`
# (empty values are fine; functions degrade to documented fixtures).

# data.sfgov.org app token (optional but recommended — lifts anonymous rate
# limits). Free: data.sfgov.org -> profile -> app tokens.
SOCRATA_APP_TOKEN=

# Google Cloud key with "Places API (New)" enabled. Set a quota cap in the
# console so a bug can't bill you. Used by get_restaurants + check_clearance.
GOOGLE_PLACES_KEY=

# Ticketmaster Discovery API key (developer.ticketmaster.com). Used by get_events.
TICKETMASTER_KEY=

# Optional: URL of a JSON mirror of the SFMTA weekly event-closure list
# (shape documented in packages/rollaway/get_closures/data/sfmta_events.json).
# Leave empty to use the bundled sample.
SFMTA_EVENTS_URL=
